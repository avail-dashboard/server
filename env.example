# Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_TYPE=postgresql
# For local development
DATABASE_URL=postgresql://avail_user:<REDACTED>@pg.avail.naxatar.com:5432/avail_explorer_qa
# For production
# DATABASE_URL=postgresql://avail_user:<REDACTED>@pg.avail.naxatar.com:5432/avail_explorer

# Redis Configuration (optional in development)
REDIS_URL=redis://localhost:6379

# Blockchain Data Sources
AVAIL_RPC_ENDPOINT=wss://mainnet-rpc.avail.so/ws
SUBSCAN_API_KEY=your-subscan-api-key
SUBSCAN_BASE_URL=https://avail.api.subscan.io
SUBQUERY_ENDPOINT=https://your-subquery-endpoint.com/graphql

# External APIs
COINGECKO_API_KEY=your-coingecko-key

# Feature Flags
ENABLE_WEBSOCKETS=true
ENABLE_CACHING=false
ENABLE_RATE_LIMITING=true
ENABLE_ANALYTICS=true

# Security
JWT_SECRET=your-jwt-secret-key-here
API_RATE_LIMIT=100

# Logging
LOG_LEVEL=info
LOG_MAX_FILES=14
LOG_MAX_SIZE=20m

# Bull Queue
REDIS_QUEUE_DB=1

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9464 