  incremental
  live
}

enum AccountType {
  regular
  validator
  nominator
  pool_member
}

enum ValidatorStatus {
  active
  waiting
  inactive
  slashed
}

enum TransferStatus {
  success
  failed
}

enum RewardType {
  validator
  nominator
