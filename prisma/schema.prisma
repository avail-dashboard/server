// Simplified Prisma schema - ALL foreign key constraints removed
// Relations kept as string references for application-level handling

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Block {
  number               Int              @id
  hash                 String           @unique @db.VarChar(66)
  parentHash           String?          @map("parent_hash") @db.VarChar(66)
  stateRoot            String?          @map("state_root") @db.VarChar(66)
  extrinsicsRoot       String?          @map("extrinsics_root") @db.VarChar(66)
  timestamp            DateTime
  extrinsicsCount      Int              @default(0) @map("extrinsics_count")
  eventsCount          Int              @default(0) @map("events_count")
  
  // Validator info (no FK constraint)
  validatorAddress     String?          @map("validator_address") @db.VarChar(64)
  
  // Block metadata
  specVersion          Int?             @map("spec_version")
  totalFees            Decimal?         @map("total_fees") @db.Decimal(65,18)
  transferCount        Int?             @map("transfer_count")
  createdAt            DateTime         @default(now()) @map("created_at")
  
  // Indexes for performance (FK indexes removed)
  @@index([timestamp], name: "idx_blocks_timestamp")
  @@index([hash], name: "idx_blocks_hash")
  @@index([validatorAddress], name: "idx_blocks_validator")
  @@map("blocks")
}

model Extrinsic {
  id               Int      @id @default(autoincrement())
  hash             String   @db.VarChar(66)  // Removed @unique - Substrate allows duplicate hashes across blocks
  
  // Block reference (no FK constraint)
  blockNumber      Int      @map("block_number")
  blockHash        String?  @map("block_hash") @db.VarChar(66)  // Denormalized
  blockTimestamp   DateTime? @map("block_timestamp")            // Denormalized
  
  extrinsicIndex   Int      @map("extrinsic_index")
  module           String?  @db.VarChar(50)
  call             String?  @db.VarChar(50)
  success          Boolean?
  timestamp        DateTime?
  signer           String?  @db.VarChar(64)
  fee              Decimal? @db.Decimal(65,18)
  
  // Extrinsic details
  nonce            Int?
  lifetime         Json?    // { birth: number, death: number, immortal: boolean }
  parameters       Json?    // Complete extrinsic arguments
  signatureInfo    Json?    @map("signature_info") // { signature, signedExtensions }
  tip              Decimal? @db.Decimal(65,18)
  actualFee        Decimal? @map("actual_fee") @db.Decimal(65,18) // Calculated from events
  transferCount    Int?     @map("transfer_count") // Number of transfers in this extrinsic
  methodObject     Json?    @map("method_object") // Complete method object
  methodArgs       Json?    @map("method_args") // Method arguments separately
  extrinsicOrder   Int?     @map("extrinsic_order") // Order within block
  createdAt        DateTime @default(now()) @map("created_at")
  
  // Substrate-compatible unique identification: block + extrinsic index
  @@unique([blockNumber, extrinsicIndex], name: "unique_block_extrinsic")
  @@index([blockNumber], name: "idx_extrinsics_block")
  @@index([hash], name: "idx_extrinsics_hash")
  @@index([hash, blockNumber], name: "idx_extrinsics_hash_block")  // Efficient lookup for hash+block
  @@index([signer], name: "idx_extrinsics_signer")
  @@index([timestamp], name: "idx_extrinsics_timestamp")
  @@index([blockNumber, extrinsicOrder], name: "idx_extrinsics_block_order")
  @@map("extrinsics")
}

model Account {
  address              String   @id @db.VarChar(64)
  balance              Decimal? @db.Decimal(65,18)
  nonce                Int?
  
  // Account balances (using Decimal for unlimited precision)
  currentBalance       Decimal?  @map("current_balance") @db.Decimal(65,18)
  reservedBalance      Decimal?  @map("reserved_balance") @db.Decimal(65,18)
  frozenBalance        Decimal?  @map("frozen_balance") @db.Decimal(65,18)
  
  // Account metadata
  accountType          AccountType @default(regular) @map("account_type")
  identityName         String?  @map("identity_name") @db.VarChar(255)
  identityInfo         Json?    @map("identity_info")
  firstSeenBlock       Int?     @map("first_seen_block")
  lastActivityBlock    Int?     @map("last_activity_block")
  transactionCount     Int?     @default(0) @map("transaction_count")
  transferCount        Int?     @default(0) @map("transfer_count")
  lastUpdated          DateTime @default(now()) @map("last_updated")
  
  @@index([balance], name: "idx_accounts_balance")
  @@index([currentBalance], name: "idx_accounts_current_balance")
  @@index([accountType], name: "idx_accounts_type")
  @@index([lastActivityBlock], name: "idx_accounts_last_activity")
  @@map("accounts")
}

model Event {
  id             Int      @id @default(autoincrement())
  
  // Block reference (no FK constraint)
  blockNumber    Int      @map("block_number")
  blockHash      String?  @map("block_hash") @db.VarChar(66)     // Denormalized
  blockTimestamp DateTime? @map("block_timestamp")               // Denormalized
  
  extrinsicIndex Int?     @map("extrinsic_index")
  eventIndex     Int?     @map("event_index")
  module         String?  @db.VarChar(50)
  eventName      String?  @map("event_name") @db.VarChar(50)
  data           Json?
  topics         Json?    // Array of topic strings for event filtering
  timestamp      DateTime?
  
  // Event details
  phase          Json?    // Event phase object
  phaseType      String?  @map("phase_type") @db.VarChar(50) // ApplyExtrinsic, Finalization, Initialization
  methodObject   Json?    @map("method_object") // Complete method object when available
  eventOrder     Int?     @map("event_order") // Order within block
  createdAt      DateTime @default(now()) @map("created_at")
  
  @@index([blockNumber], name: "idx_events_block")
  @@index([module], name: "idx_events_module")
  @@index([timestamp], name: "idx_events_timestamp")
  @@index([phaseType], name: "idx_events_phase_type")
  @@index([blockNumber, eventOrder], name: "idx_events_block_order")
  @@map("events")
}

model Watchlist {
  id        Int      @id @default(autoincrement())
  userId    String?  @map("user_id") @db.VarChar(255)
  address   String?  @db.VarChar(64)
  label     String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  
  @@index([userId], name: "idx_watchlists_user")
  @@map("watchlists")
}

model SyncState {
  id                  Int       @id @default(autoincrement())
  lastSyncedBlock     Int       @default(0) @map("last_synced_block")
  targetBlock         Int?      @map("target_block")
  syncStatus          SyncStatus @default(idle) @map("sync_status")
  syncMode            SyncMode   @default(incremental) @map("sync_mode")
  blocksPerMinute     Int?      @map("blocks_per_minute")
  estimatedCompletion DateTime? @map("estimated_completion")
  errorCount          Int       @default(0) @map("error_count")
  lastError           String?   @map("last_error")
  lastErrorBlock      Int?      @map("last_error_block")
  startedAt           DateTime? @map("started_at")
  pausedAt            DateTime? @map("paused_at")
  completedAt         DateTime? @map("completed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")
  
  @@index([syncStatus], name: "idx_sync_state_status")
  @@index([lastSyncedBlock], name: "idx_sync_state_last_synced")
  @@map("sync_state")
}

model DataSubmission {
  id             Int      @id @default(autoincrement())
  extrinsicHash  String   @unique @map("extrinsic_hash") @db.VarChar(66)
  
  // Block reference (no FK constraint)
  blockNumber    Int      @map("block_number")
  blockHash      String?  @map("block_hash") @db.VarChar(66)     // Denormalized
  blockTimestamp DateTime? @map("block_timestamp")               // Denormalized
  
  extrinsicIndex Int?     @map("extrinsic_index")
  
  // App/Rollup reference (no FK constraint)
  appId          Int      @map("app_id")
  rollupName     String?  @map("rollup_name") @db.VarChar(255)   // Denormalized
  
  // Data submission details
  dataSize       Int      @map("data_size")
  dataHash       String   @map("data_hash") @db.VarChar(66)
  submitter      String   @db.VarChar(64)                        // No FK constraint
  timestamp      DateTime
  success        Boolean  @default(true)
  blobData       Bytes?   @map("blob_data")
  kateCommitment String?  @map("kate_commitment") @db.Text
  proof          Json?
  createdAt      DateTime @default(now()) @map("created_at")
  
  @@index([blockNumber], name: "idx_data_submissions_block")
  @@index([appId], name: "idx_data_submissions_app_id")
  @@index([submitter], name: "idx_data_submissions_submitter")
  @@index([timestamp], name: "idx_data_submissions_timestamp")
  @@index([extrinsicHash], name: "idx_data_submissions_hash")
  @@map("data_submissions")
}

model Rollup {
  appId             Int      @id @map("app_id")
  name              String   @db.VarChar(255)
  description       String?
  firstSeenBlock    Int?     @map("first_seen_block")
  lastActiveBlock   Int?     @map("last_active_block")
  totalSubmissions  Int      @default(0) @map("total_submissions")
  totalDataSize     Int      @default(0) @map("total_data_size")
  totalFeesPaid     Int      @default(0) @map("total_fees_paid")
  website           String?  @db.VarChar(255)
  logoUrl           String?  @map("logo_url") @db.VarChar(255)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")
  
  @@index([name], name: "idx_rollups_name")
  @@index([lastActiveBlock], name: "idx_rollups_last_active")
  @@map("rollups")
}

model Validator {
  stashAddress        String      @id @map("stash_address") @db.VarChar(64)
  
  // Account references (no FK constraints)
  controllerAddress   String?     @unique @map("controller_address") @db.VarChar(64)
  rewardAddress       String?     @unique @map("reward_address") @db.VarChar(64)
  
  // Validator details
  commission          Int         // Stored as Perbill (parts per billion)
  selfBonded          Decimal     @map("self_bonded") @db.Decimal(65,18)
  totalBonded         Decimal     @map("total_bonded") @db.Decimal(65,18)
  nominatorCount      Int         @default(0) @map("nominator_count")
  status              ValidatorStatus @default(inactive)
  sessionKeys         Json?       @map("session_keys") // All session keys
  
  // Identity (denormalized)
  identityName        String?     @map("identity_name") @db.VarChar(255)
  identityInfo        Json?       @map("identity_info")
  
  // Performance tracking
  blocksProduced      Int         @default(0) @map("blocks_produced")
  lastBlockProduced   Int?        @map("last_block_produced")
  firstSeenBlock      Int?        @map("first_seen_block")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @default(now()) @updatedAt @map("updated_at")
  
  @@index([status], name: "idx_validators_status")
  @@index([totalBonded], name: "idx_validators_total_bonded")
  @@index([commission], name: "idx_validators_commission")
  @@index([lastBlockProduced], name: "idx_validators_last_block")
  @@index([firstSeenBlock], name: "idx_validators_first_seen")
  @@map("validators")
}

model Transfer {
  id              String      @id // format: "{extrinsic_hash}-{index}"
  
  // Extrinsic reference (no FK constraint)
  extrinsicHash   String      @map("extrinsic_hash") @db.VarChar(66)
  
  // Block reference (no FK constraint)
  blockNumber     Int         @map("block_number")
  blockHash       String?     @map("block_hash") @db.VarChar(66)      // Denormalized
  blockTimestamp  DateTime?   @map("block_timestamp")                 // Denormalized
  
  extrinsicIndex  Int         @map("extrinsic_index")
  
  // Account references (no FK constraints)
  fromAddress     String      @map("from_address") @db.VarChar(64)
  toAddress       String      @map("to_address") @db.VarChar(64)
  
  // Transfer details
  amount          Decimal     @db.Decimal(65,18)
  tokenType       String      @default("AVAIL") @map("token_type") @db.VarChar(10)
  fees            Decimal     @db.Decimal(65,18)
  status          TransferStatus @default(success)
  timestamp       DateTime
  createdAt       DateTime    @default(now()) @map("created_at")
  
  @@index([blockNumber], name: "idx_transfers_block")
  @@index([extrinsicHash], name: "idx_transfers_extrinsic")
  @@index([fromAddress], name: "idx_transfers_from")
  @@index([toAddress], name: "idx_transfers_to")
  @@index([timestamp], name: "idx_transfers_timestamp")
  @@index([amount], name: "idx_transfers_amount")
  @@map("transfers")
}

model Nomination {
  id                String      @id // format: "{nominator}-{validator}"
  
  // Account and Validator references (no FK constraints)
  nominatorAddress  String      @map("nominator_address") @db.VarChar(64)
  validatorAddress  String      @map("validator_address") @db.VarChar(64)
  
  amount            Decimal     @db.Decimal(65,18)
  era               Int?
  active            Boolean     @default(true)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @default(now()) @updatedAt @map("updated_at")
  
  @@index([nominatorAddress], name: "idx_nominations_nominator")
  @@index([validatorAddress], name: "idx_nominations_validator")
  @@index([era], name: "idx_nominations_era")
  @@index([active], name: "idx_nominations_active")
  @@map("nominations")
}

model Era {
  number          Int         @id
  startBlock      Int         @map("start_block")
  endBlock        Int?        @map("end_block")
  totalStaked     Decimal     @map("total_staked") @db.Decimal(65,18)
  validatorCount  Int         @map("validator_count")
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now()) @map("created_at")
  
  @@index([startBlock], name: "idx_eras_start_block")
  @@index([active], name: "idx_eras_active")
  @@map("eras")
}

model Reward {
  id                String      @id // format: "{address}-{era}-{type}"
  
  // Account reference (no FK constraint)
  address           String      @db.VarChar(64)
  
  // Validator reference (no FK constraint)
  validatorAddress  String?     @map("validator_address") @db.VarChar(64)
  
  amount            Decimal     @db.Decimal(65,18)
  
  // Era reference (no FK constraint)
  era               Int
  
  rewardType        RewardType  @map("reward_type")
  
  // Block reference (no FK constraint)
  blockNumber       Int         @map("block_number")
  blockHash         String?     @map("block_hash") @db.VarChar(66)      // Denormalized
  blockTimestamp    DateTime?   @map("block_timestamp")                 // Denormalized
  
  timestamp         DateTime
  createdAt         DateTime    @default(now()) @map("created_at")
  
  @@index([address], name: "idx_rewards_address")
  @@index([validatorAddress], name: "idx_rewards_validator")
  @@index([era], name: "idx_rewards_era")
  @@index([rewardType], name: "idx_rewards_type")
  @@index([blockNumber], name: "idx_rewards_block")
  @@map("rewards")
}

// ===== ENUMS =====

enum SyncStatus {
  idle
  syncing
  paused
  error
  completed
}

enum SyncMode {
  full
  incremental
  live
}

enum AccountType {
  regular
  validator
  nominator
  pool_member
}

enum ValidatorStatus {
  active
  waiting
  inactive
  slashed
}

enum TransferStatus {
  success
  failed
}

enum RewardType {
  validator
  nominator
  slash
}