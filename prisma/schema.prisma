// Avail Explorer Prisma schema matching actual database structure
// Based on the comprehensive SQL schema and actual table data

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// Block headers matching CURRENT database structure (will be migrated)
model Block {
  id                     Int       @id @default(autoincrement())
  number                 BigInt    @map("block_number")
  hash                   String    @map("block_hash") @db.VarChar(66)
  parentHash             String    @map("parent_hash") @db.VarChar(66)
  stateRoot              String    @map("state_root") @db.VarChar(66)
  extrinsicsRoot         String    @map("extrinsics_root") @db.VarChar(66)
  
  // Current structure (before migration)
  timestampUtc           DateTime? @map("timestamp_utc")
  authorAccount          String?   @map("author_account") @db.VarChar(256)
  isFinalized            Boolean?  @default(false) @map("is_finalized")
  finalizationDelayMs    Int?      @map("finalization_delay_ms")
  
  // Block statistics
  extrinsicsCount        Int?      @default(0) @map("extrinsics_count")
  eventsCount            Int?      @default(0) @map("events_count")
  dataSubmissionsCount   Int?      @default(0) @map("data_submissions_count")
  totalFees              BigInt?   @default(0) @map("total_fees")
  totalTips              BigInt?   @default(0) @map("total_tips")
  
  // Runtime information
  specVersion            BigInt?   @map("spec_version")
  implVersion            BigInt?   @map("impl_version")
  authoringVersion       BigInt?   @map("authoring_version")
  transactionVersion     BigInt?   @map("transaction_version")
  stateVersion           BigInt?   @map("state_version")
  
  // Raw data for reconstruction
  digestJson             Json?     @map("digest_json")
  headerRawHex           String?   @map("header_raw_hex")
  extractionVersion      String?   @default("2.0.0") @map("extraction_version") @db.VarChar(10)
  specName               String?   @map("spec_name") @db.VarChar(50)
  implName               String?   @map("impl_name") @db.VarChar(50)
  chainName              String?   @map("chain_name") @db.VarChar(100)
  nodeVersion            String?   @map("node_version") @db.VarChar(50)
  chainProperties        Json?     @map("chain_properties")
  
  @@unique([number])
  @@unique([hash])
  @@index([number])
  @@index([timestampUtc])
  @@index([authorAccount])
  @@map("block_headers")
}

// Kate commitments (Avail DA specific)
model KateCommitment {
  id                    Int     @id @default(autoincrement())
  blockHash             String  @map("block_hash") @db.VarChar(66)
  blockNumber           BigInt  @map("block_number")
  
  // Kate commitment data
  rows                  Int?
  cols                  Int?
  dataRoot              String? @map("data_root") @db.VarChar(66)
  blockLength           BigInt? @map("block_length")
  
  // Commitment proof data
  commitmentHex         String? @map("commitment_hex")
  proofData             Json?   @map("proof_data")
  
  // DA metrics
  utilizationPercentage Decimal? @map("utilization_percentage") @db.Decimal(5,2)
  appDataCount          Int?    @default(0) @map("app_data_count")
  
  // Sampling and extraction data (ACTIVELY POPULATED)
  sampleDataProof       Json?   @map("sample_data_proof")
  sampleRowData         Json?   @map("sample_row_data")
  kateAvailable         Boolean? @default(true) @map("kate_available")
  kateExtractionNote    String? @map("kate_extraction_note")
  
  @@index([blockNumber])
  @@index([blockHash])
  @@map("kate_commitments")
}

// Application Registrations table removed - not being populated

// Comprehensive Extrinsic Data
model Extrinsic {
  id              Int       @id @default(autoincrement())
  blockHash       String    @map("block_hash") @db.VarChar(66)
  blockNumber     BigInt    @map("block_number")
  extrinsicIndex  Int       @map("extrinsic_index")
  hash            String    @map("extrinsic_hash") @db.VarChar(66)
  
  // Extrinsic metadata
  isSigned        Boolean   @map("is_signed")
  signer          String?   @map("signer_account") @db.VarChar(256)
  module          String    @map("method_pallet") @db.VarChar(50)
  call            String    @map("method_name") @db.VarChar(50)
  
  // Transaction details
  nonce           BigInt?
  tip             BigInt?   @default(0)
  fee             BigInt?   @default(0)
  
  // Execution results
  success         Boolean?
  errorMessage    String?   @map("error_message")
  
  // Data and signatures  
  methodArgs      Json?     @map("method_args")
  // signatureData, eraData removed: parse from rawHex when needed
  
  // Raw data for reconstruction
  rawHex          String?   @map("raw_hex")
  lengthBytes     Int?      @map("length_bytes")
  
  @@unique([blockHash, extrinsicIndex])
  @@index([blockNumber])
  @@index([hash])
  @@index([signer])
  @@index([module, call])
  @@index([success])
  @@map("extrinsic_data")
}

// Event data
model Event {
  id             Int      @id @default(autoincrement())
  blockHash      String   @map("block_hash") @db.VarChar(66)
  blockNumber    BigInt   @map("block_number")
  eventIndex     Int      @map("event_index")
  
  extrinsicId    Int?     @map("extrinsic_id")
  extrinsicIndex Int?     @map("extrinsic_index")
  phaseType      String?  @map("phase_type") @db.VarChar(20)
  phaseValue     Int?     @map("phase_value")
  
  pallet         String   @db.VarChar(50)
  eventName      String   @map("event_name") @db.VarChar(50)
  topics         String[] // Array of topic strings
  
  rawData        Json?    @map("raw_data")
  
  @@unique([blockHash, eventIndex])
  @@index([blockNumber])
  @@index([extrinsicId])
  @@index([pallet, eventName])
  @@map("event_data")
}

// Account profiles with metadata
model Account {
  id                      Int       @id @default(autoincrement())
  accountId               String    @unique @map("account_id") @db.VarChar(256)
  
  // Account metadata
  displayName             String?   @map("display_name") @db.VarChar(100)
  identityJudgement       String?   @map("identity_judgement") @db.VarChar(20)
  isValidator             Boolean   @default(false) @map("is_validator")
  isNominator             Boolean   @default(false) @map("is_nominator")
  
  // Current state (updated per block)
  currentNonce            BigInt    @default(0) @map("current_nonce")
  
  // Statistics
  totalExtrinsicsSent     Int       @default(0) @map("total_extrinsics_sent")
  totalExtrinsicsReceived Int       @default(0) @map("total_extrinsics_received")
  totalTransfersSent      Int       @default(0) @map("total_transfers_sent")
  totalTransfersReceived  Int       @default(0) @map("total_transfers_received")
  totalValueSent          BigInt    @default(0) @map("total_value_sent")
  totalValueReceived      BigInt    @default(0) @map("total_value_received")
  
  // Activity tracking
  firstSeenBlock          BigInt?   @map("first_seen_block")
  firstSeenTimestamp      DateTime? @map("first_seen_timestamp")
  lastActivityBlock       BigInt?   @map("last_activity_block")
  lastActivityTimestamp   DateTime? @map("last_activity_timestamp")
  
  @@index([isValidator])
  @@index([lastActivityBlock])
  @@map("account_profiles")
}

// Balance history
model BalanceHistory {
  id              Int     @id @default(autoincrement())
  accountId       String  @map("account_id") @db.VarChar(256)
  blockHash       String  @map("block_hash") @db.VarChar(66)
  blockNumber     BigInt  @map("block_number")
  
  balanceFree     BigInt  @map("balance_free")
  balanceReserved BigInt  @map("balance_reserved")
  balanceFrozen   BigInt  @default(0) @map("balance_frozen")
  
  nonce           BigInt  @map("nonce")
  consumers       BigInt  @default(0) @map("consumers")
  providers       BigInt  @default(0) @map("providers")
  sufficients     BigInt  @default(0) @map("sufficients")
  
  freeChange      BigInt  @default(0) @map("free_change")
  reservedChange  BigInt  @default(0) @map("reserved_change")
  
  @@unique([accountId, blockHash])
  @@index([accountId])
  @@index([blockNumber])
  @@map("balance_history")
}

// Data Submissions (Avail DA specific)
model DataSubmission {
  id               Int       @id @default(autoincrement())
  blockHash        String    @map("block_hash") @db.VarChar(66)
  blockNumber      BigInt    @map("block_number")
  extrinsicId      Int?      @map("extrinsic_id")
  
  // Submission details
  appId            BigInt    @map("app_id")
  submitter        String    @map("submitter_account") @db.VarChar(256)
  dataSize         Int       @map("data_size")
  
  // DA specific data removed - never populated
  // dataIndex, dataHash, proofData removed - never populated
  
  // Fee information
  submissionFee    BigInt?   @default(0) @map("submission_fee")
  
  @@index([blockNumber])
  @@index([appId])
  @@index([submitter])
  @@index([appId, blockNumber])
  @@map("data_submissions")
}

// AVAIL Transfer Events
model Transfer {
  id              Int       @id @default(autoincrement())
  blockHash       String    @map("block_hash") @db.VarChar(66)
  blockNumber     BigInt    @map("block_number")
  eventId         Int?      @map("event_id")
  // extrinsicId removed - never populated
  
  // Transfer details
  fromAccount     String    @map("from_account") @db.VarChar(256)
  toAccount       String    @map("to_account") @db.VarChar(256)
  amount          BigInt    @map("amount")
  
  // Transfer metadata
  transferType    String    @default("Transfer") @map("transfer_type") @db.VarChar(20) // Transfer, Reserve, Unreserve, etc.
  success         Boolean   @default(true)
  
  // Fee information
  feePaid         BigInt    @default(0) @map("fee_paid")
  tipPaid         BigInt    @default(0) @map("tip_paid")
  
  @@index([fromAccount])
  @@index([toAccount])
  @@index([blockNumber])
  @@index([amount])
  @@map("transfer_events")
}

// ================================
// NETWORK ANALYTICS AND STATISTICS
// ================================

// Network Statistics (Per-block network metrics)
model NetworkStatistics {
  id                     Int       @id @default(autoincrement())
  blockHash              String    @unique @map("block_hash") @db.VarChar(66)
  blockNumber            BigInt    @map("block_number")
  
  // Block statistics
  extrinsicsCount        Int?      @map("extrinsics_count")
  eventsCount            Int?      @map("events_count")
  signedExtrinsicsCount  Int?      @map("signed_extrinsics_count")
  unsignedExtrinsicsCount Int?     @map("unsigned_extrinsics_count")
  
  // Fee and tip statistics
  totalTips              BigInt?   @default(0) @map("total_tips")
  totalFees              BigInt?   @default(0) @map("total_fees")
  averageTip             BigInt?   @default(0) @map("average_tip")
  averageFee             BigInt?   @default(0) @map("average_fee")
  
  // DA statistics
  daSubmissionsCount     Int?      @default(0) @map("da_submissions_count")
  daTotalDataSize        BigInt?   @default(0) @map("da_total_data_size")
  daUniqueAppsCount      Int?      @default(0) @map("da_unique_apps_count")
  
  // Account statistics
  totalAccountsCount     Int?      @default(0) @map("total_accounts_count")
  activeAccountsCount    Int?      @default(0) @map("active_accounts_count")
  
  // Indexing metadata
  indexedAt              DateTime? @default(now()) @map("indexed_at")
  
  @@index([blockNumber])
  @@index([blockHash])
  @@map("network_statistics")
}

// Balance Summary (Per-block balance aggregations)
model BalanceSummary {
  id                     Int       @id @default(autoincrement())
  blockHash              String    @unique @map("block_hash") @db.VarChar(66)
  blockNumber            BigInt    @map("block_number")
  
  // Total supply and balance statistics
  totalIssuance          BigInt    @map("total_issuance")
  totalBalanceAccounts   Int?      @default(0) @map("total_balance_accounts")
  totalFreeBalance       BigInt?   @default(0) @map("total_free_balance")
  totalReservedBalance   BigInt?   @default(0) @map("total_reserved_balance")
  totalFrozenBalance     BigInt?   @default(0) @map("total_frozen_balance")
  
  // Processing metadata
  balancePagesLoaded     Int?      @default(0) @map("balance_pages_loaded")
  balanceExtractionNote  String?   @map("balance_extraction_note")
  indexedAt              DateTime? @default(now()) @map("indexed_at")
  
  @@index([blockNumber])
  @@index([blockHash])
  @@map("balances_summary")
}

// Storage States (Per-block runtime storage snapshots)
model StorageState {
  id                     Int       @id @default(autoincrement())
  blockHash              String    @unique @map("block_hash") @db.VarChar(66)
  blockNumber            BigInt    @map("block_number")
  
  // Runtime storage data
  systemData             Json?     @map("system_data")
  balancesData           Json?     @map("balances_data")
  totalIssuance          BigInt?   @map("total_issuance")
  
  // DA app data
  daNextAppId            BigInt?   @map("da_next_app_id")
  daAppKeys              Json?     @map("da_app_keys")
  daDataSubmissions      Json?     @map("da_data_submissions")
  
  // Validator/session data
  sessionValidators      Json?     @map("session_validators")
  sessionValidatorCount  Int?      @map("session_validator_count")
  stakingCurrentEra      BigInt?   @map("staking_current_era")
  
  // Processing metadata
  storageExtractionNote  String?   @map("storage_extraction_note")
  indexedAt              DateTime? @default(now()) @map("indexed_at")
  
  @@index([blockNumber])
  @@index([blockHash])
  @@map("storage_states")
}

