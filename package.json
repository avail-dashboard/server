{
  "name": "avail-explorer-backend",
  "version": "1.0.0",
  "description": "Backend server for Avail blockchain explorer",
  "main": "dist/index.js",
  "scripts": {
    "setup": "node setup-dev.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "jest tests/e2e",
    "test:ci": "jest --coverage --watchAll=false --passWithNoTests",
    "test:all": "npm run build && npm run lint && npm test",
    "test:critical": "npm run build && npm run lint && npm run test:unit && npm run test:e2e",
    "migrate": "node dist/database/migrate.js",
    "seed": "node dist/database/seed.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "lint:check": "eslint src/**/*.ts --max-warnings 0",
    "format": "prettier --write src/**/*.ts",
    "validate:workflows": "node .github/validate-workflows.js",
    "pre-commit": "npm run test:critical",
    "prepare": "husky install"
  },
  "dependencies": {
    "@polkadot/api": "^15.9.3",
    "@polkadot/api-augment": "^15.9.3",
    "@polkadot/keyring": "^13.5.1",
    "@polkadot/rpc-core": "^15.9.3",
    "@polkadot/rpc-provider": "^15.9.3",
    "@polkadot/types": "^15.9.3",
    "@polkadot/util": "^13.5.1",
    "@polkadot/util-crypto": "^13.5.1",
    "axios": "^1.6.2",
    "bull": "^4.12.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "joi": "^17.11.0",
    "node-cron": "^3.0.3",
    "pg": "^8.11.3",
    "prom-client": "^15.1.0",
    "redis": "^4.6.11",
    "smoldot": "^2.0.35",
    "socket.io": "^4.7.4",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@types/bull": "^4.10.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.4",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.55.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.0",
    "supertest": "^7.1.1",
    "ts-jest": "^29.1.1",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "resolutions": {
    "@polkadot/api": "15.9.3",
    "@polkadot/api-augment": "15.9.3",
    "@polkadot/keyring": "13.5.1",
    "@polkadot/rpc-core": "15.9.3",
    "@polkadot/rpc-provider": "15.9.3",
    "@polkadot/types": "15.9.3",
    "@polkadot/util": "13.5.1",
    "@polkadot/util-crypto": "13.5.1",
    "@polkadot/types-create": "15.9.3",
    "@polkadot/types-codec": "15.9.3",
    "@polkadot/types-known": "15.9.3",
    "@polkadot/api-derive": "15.9.3"
  },
  "keywords": [
    "avail",
    "blockchain",
    "explorer",
    "api",
    "backend"
  ],
  "author": "",
  "license": "MIT"
}
