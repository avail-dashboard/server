#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running critical pre-commit checks..."
echo "📋 This includes: Build + Lint + Unit Tests + E2E Tests"
echo "⚠️  Integration tests are skipped (known API response structure issues)"

# Run critical tests (build + lint + unit + e2e)
npm run test:critical

if [ $? -eq 0 ]; then
    echo ""
    echo "✅ All critical checks passed!"
    echo "🚀 Proceeding with commit..."
    echo ""
    echo "💡 To run all tests including integration: npm run test:all"
else
    echo ""
    echo "❌ Critical checks failed!"
    echo "🛠️  Please fix the issues before committing"
    echo ""
    echo "🔧 Quick fixes:"
    echo "   - Build errors: Check TypeScript compilation"
    echo "   - Lint errors: Run 'npm run lint:fix'"
    echo "   - Test failures: Check unit and E2E tests"
    echo ""
    exit 1
fi 